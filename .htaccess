RewriteEngine On

# 1. Forzar HTTPS, sin-www y dominio canónico (.es redirige página a página)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.problabtools\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(www\.)?problabtools\.es$ [NC]
RewriteRule ^(.*)$ https://problabtools.com/$1 [L,R=301]

# 2. Redirigir index.html a /
RewriteRule ^index\.html$ / [R=301,L]

# 2b. Redirigir en/index.html a en/
RewriteRule ^en/index\.html$ /en/ [R=301,L]

# 3. Eliminar parámetro ?q= de la home
RewriteCond %{QUERY_STRING} ^q=
RewriteRule ^$ /? [R=301,L]

# 4. Bloquear ficheros internos (scripts y documentación del repositorio)
<FilesMatch "\.(?:py|md)$">
  Require all denied
</FilesMatch>

# 5. Cache
<IfModule mod_headers.c>
  # El HTML se revalida siempre (respuestas 304 cuando no ha cambiado), de modo
  # que cualquier despliegue se refleja de inmediato y arrastra las nuevas
  # versiones de CSS/JS a través del parámetro ?v= de sus URLs.
  <FilesMatch "\.(?:html?|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS y JavaScript llevan versionado en la URL (?v=...), así que pueden
  # cachearse indefinidamente: al cambiar la versión cambia la URL y el
  # navegador descarga el fichero nuevo.
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes e iconos: cache de 30 días.
  <FilesMatch "\.(?:png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# 6. Compresión de texto. Las páginas de tablas incluyen las tablas
# pre-renderizadas en el HTML (repetitivas → comprimen ~10:1), así que la
# compresión reduce mucho el peso de transferencia. Si el módulo no está
# disponible, el bloque se ignora sin efecto.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    application/javascript application/xml application/xml+rss \
    image/svg+xml application/json
</IfModule>
