RewriteEngine On

# URL canónica para Google: siempre HTTPS, sin www y con el path conservado.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^problabtools\.com$ [NC]
RewriteRule ^ https://problabtools.com%{REQUEST_URI} [R=301,L,NE]

# La portada canónica es /, no /index.html.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://problabtools.com/ [R=301,L,NE]

# Google llegó a descubrir /?q={search_term_string}; no hay página de búsqueda,
# así que cualquier consulta q en la home debe consolidarse en la portada canónica.
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{QUERY_STRING} (^|&)q= [NC]
RewriteRule ^$ https://problabtools.com/? [R=301,L,NE]

# Cache
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|xml)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
</IfModule>
