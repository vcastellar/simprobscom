RewriteEngine On

# 1. Forzar HTTPS y sin-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.problabtools\.com$ [NC]
RewriteRule ^(.*)$ https://problabtools.com/$1 [L,R=301]

# 2. Redirigir index.html a /
RewriteRule ^index\.html$ / [R=301,L]

# 2b. Redirigir en/index.html a en/
RewriteRule ^en/index\.html$ /en/ [R=301,L]

# 3. Eliminar parámetro ?q= de la home
RewriteCond %{QUERY_STRING} ^q=
RewriteRule ^$ /? [R=301,L]

# 4. Bloquear ficheros internos (scripts y documentación del repositorio)
<FilesMatch "\.(?:py|md)$">
  Require all denied
</FilesMatch>

# 5. Cache
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|xml)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS y JavaScript se revalidan siempre para que una recarga del navegador
  # detecte nuevas versiones incluso si el usuario conservaba una copia cacheada.
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
